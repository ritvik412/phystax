# Meta Model API (dev.meta.ai -> API keys). A payment method must be on file
# before requests work, even when you are spending hackathon credits.
MODEL_API_KEY=

# Baseten Model APIs (Muse Spark Open, slug meta-models/muse-spark-open-1026)
BASETEN_API_KEY=

# Optional: wherever you serve Muse Glimmer (text + tools only today)
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=unused
GLIMMER_MODEL_ID=meta-models/Muse-Glimmer-30B

# "api" = real SAM 3.1. "synthetic" = offline stand-in for building the app; never report it.
PHYSTAX_SAM_BACKEND=api
# Hard spend caps (USD). Calls that would cross them are refused.
PHYSTAX_BUDGET_USD=120
PHYSTAX_BASETEN_BUDGET_USD=90
# Set to 0 only if Day 1 shows the SAM API rejects the metadata field
PHYSTAX_SAM_METADATA=1
PHYSTAX_RUNS=runs
PHYSTAX_CACHE=.cache
